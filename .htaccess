# ============================================
# TALASSA - PRODUCAO
# Cache, compressao e entrega de arquivos
# ============================================

# Evita listagem de diretorios
Options -Indexes

# Pagina inicial
DirectoryIndex index.html

# Garante MIME correto para AVIF
AddType image/avif .avif


# --------------------------------------------
# DOMINIO CANONICO
# www -> sem www
# HTTPS sera forçado pela Hostinger/SSL
# --------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^www\.talassapsicologia\.com\.br$ [NC]
    RewriteRule ^ https://talassapsicologia.com.br%{REQUEST_URI} [R=301,L]
</IfModule>


# --------------------------------------------
# COMPRESSAO
# --------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# --------------------------------------------
# EXPIRACAO DE CACHE
#
# HTML: sempre revalida
# CSS/JS: 1 dia, pois os nomes ainda nao tem versionamento
# imagens/fontes: 30 dias
# --------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML
    ExpiresByType text/html "access plus 0 seconds"

    # CSS e JavaScript
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"

    # Imagens
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

    # Fontes
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
</IfModule>


# --------------------------------------------
# CACHE-CONTROL
# --------------------------------------------
<IfModule mod_headers.c>

    # HTML, sitemap e robots devem sempre verificar versao nova
    <FilesMatch "\.(html?|xml|txt)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # CSS e JS: cache curto enquanto usamos nomes fixos
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # Imagens e fontes: cache mais longo
    <FilesMatch "\.(avif|webp|svg|png|jpg|jpeg|gif|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

</IfModule>